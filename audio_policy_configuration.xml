<?xml version="1.0" encoding="UTF-8"?>
<audioPolicyConfiguration version="2.0" xmlns:xi="http://www.w3.org/2001/XInclude">

    <globalConfiguration speaker_drc_enabled="true" />

    <modules>
        <module name="primary" halVersion="2.0">
            <attachedDevices>
                AUDIO_DEVICE_OUT_SPEAKER
                AUDIO_DEVICE_OUT_EARPIECE
                AUDIO_DEVICE_OUT_TELEPHONY_TX
                AUDIO_DEVICE_IN_BUILTIN_MIC
                AUDIO_DEVICE_IN_FM_TUNER
                AUDIO_DEVICE_IN_TELEPHONY_RX
            </attachedDevices>
            <defaultOutputDevice>AUDIO_DEVICE_OUT_SPEAKER</defaultOutputDevice>

            <devices>
                <device tagName="headset" type="AUDIO_DEVICE_OUT_WIRED_HEADSET">
                    <gain tagName="gain_1" mode="AUDIO_GAIN_MODE_JOINT" channel_mask="AUDIO_CHANNEL_OUT_STEREO"
                          minValueMB="-6400" maxValueMB="0" defaultValueMB="0" stepValueMB="100"
                          minRampMs="0" maxRampMs="0" />
                </device>
                <device tagName="headphone" type="AUDIO_DEVICE_OUT_WIRED_HEADPHONE">
                    <gain tagName="gain_1" mode="AUDIO_GAIN_MODE_JOINT" channel_mask="AUDIO_CHANNEL_OUT_STEREO"
                          minValueMB="-6400" maxValueMB="0" defaultValueMB="0" stepValueMB="100"
                          minRampMs="0" maxRampMs="0" />
                </device>
            </devices>

            <mixPorts>
                <mixPort name="primary output" role="source">
                    <profile name="primary" format="AUDIO_FORMAT_PCM_16_BIT">
                        <samplingRates>44100</samplingRates>
                        <channelMasks>AUDIO_CHANNEL_OUT_STEREO</channelMasks>
                    </profile>
                    <flags>AUDIO_OUTPUT_FLAG_PRIMARY</flags>
                </mixPort>
                <mixPort name="primary input" role="sink">
                    <profile name="primary" format="AUDIO_FORMAT_PCM_16_BIT">
                        <samplingRates>8000 11025 12000 16000 22050 24000 32000 44100 48000</samplingRates>
                        <channelMasks>AUDIO_CHANNEL_IN_MONO AUDIO_CHANNEL_IN_STEREO</channelMasks>
                    </profile>
                </mixPort>
            </mixPorts>

            <routes>
                <route type="mix" sink="primary output"
                       sources="AUDIO_DEVICE_OUT_EARPIECE AUDIO_DEVICE_OUT_SPEAKER AUDIO_DEVICE_OUT_WIRED_HEADSET AUDIO_DEVICE_OUT_WIRED_HEADPHONE AUDIO_DEVICE_OUT_AUX_DIGITAL AUDIO_DEVICE_OUT_ANLG_DOCK_HEADSET AUDIO_DEVICE_OUT_DGTL_DOCK_HEADSET AUDIO_DEVICE_OUT_ALL_SCO AUDIO_DEVICE_OUT_FM_TX AUDIO_DEVICE_OUT_DEFAULT" />
                <route type="mix" sink="primary input"
                       sources="AUDIO_DEVICE_IN_BUILTIN_MIC AUDIO_DEVICE_IN_COMMUNICATION AUDIO_DEVICE_IN_AMBIENT AUDIO_DEVICE_IN_WIRED_HEADSET AUDIO_DEVICE_IN_AUX_DIGITAL AUDIO_DEVICE_IN_VOICE_CALL AUDIO_DEVICE_IN_BACK_MIC AUDIO_DEVICE_IN_FM_TUNER AUDIO_DEVICE_IN_BLUETOOTH_SCO_HEADSET" />
            </routes>
        </module>

        <module name="a2dp" halVersion="2.0">
            <mixPorts>
                <mixPort name="a2dp output" role="source">
                    <profile name="a2dp" format="AUDIO_FORMAT_PCM_16_BIT">
                        <samplingRates>44100</samplingRates>
                        <channelMasks>AUDIO_CHANNEL_OUT_STEREO</channelMasks>
                    </profile>
                </mixPort>
            </mixPorts>
            <routes>
                <route type="mix" sink="a2dp output" sources="AUDIO_DEVICE_OUT_ALL_A2DP" />
            </routes>
        </module>

        <module name="usb" halVersion="2.0">
            <mixPorts>
                <mixPort name="usb output" role="source">
                    <profile name="usb" format="AUDIO_FORMAT_PCM_16_BIT">
                        <samplingRates>44100</samplingRates>
                        <channelMasks>AUDIO_CHANNEL_OUT_STEREO</channelMasks>
                    </profile>
                </mixPort>
            </mixPorts>
            <routes>
                <route type="mix" sink="usb output" sources="AUDIO_DEVICE_OUT_ALL_USB" />
            </routes>
        </module>

        <module name="r_submix" halVersion="2.0">
            <attachedDevices>
                AUDIO_DEVICE_IN_REMOTE_SUBMIX
            </attachedDevices>
            <mixPorts>
                <mixPort name="r_submix output" role="source">
                    <profile name="r_submix" format="AUDIO_FORMAT_PCM_16_BIT">
                        <samplingRates>48000</samplingRates>
                        <channelMasks>AUDIO_CHANNEL_OUT_STEREO</channelMasks>
                    </profile>
                </mixPort>
                <mixPort name="r_submix input" role="sink">
                    <profile name="r_submix" format="AUDIO_FORMAT_PCM_16_BIT">
                        <samplingRates>48000</samplingRates>
                        <channelMasks>AUDIO_CHANNEL_IN_STEREO</channelMasks>
                    </profile>
                </mixPort>
            </mixPorts>
            <routes>
                <route type="mix" sink="r_submix output" sources="AUDIO_DEVICE_OUT_REMOTE_SUBMIX" />
                <route type="mix" sink="r_submix input" sources="AUDIO_DEVICE_IN_REMOTE_SUBMIX" />
            </routes>
        </module>
    </modules>
</audioPolicyConfiguration>
